# ==========================================
# PostmanPingBot Environment Variables
# ==========================================

# 1. Telegram Configuration
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
# Your personal Telegram User ID (obtain via @userinfobot)
TELEGRAM_OWNER_ID="12345678"
# Secret token to secure Telegram Webhook (1-256 chars, A-Z, a-z, 0-9, _, -)
TELEGRAM_SECRET_TOKEN="your_random_telegram_secret_token_here"

# 2. Upstash Redis (Serverless KV store)
UPSTASH_REDIS_REST_URL="https://example.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token_here"

# 3. Google OAuth 2.0 & Gmail API
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
# Must match Authorized Redirect URI in Google Cloud Console
GOOGLE_REDIRECT_URI="https://your-app.vercel.app/api/oauth/callback"

# 4. Google Cloud Pub/Sub
# Full topic path: projects/{PROJECT_ID}/topics/{TOPIC_NAME}
PUBSUB_TOPIC_NAME="projects/your-gcp-project/topics/gmail-push-topic"
# The dedicated service account configured on the Pub/Sub push subscription
PUBSUB_SERVICE_ACCOUNT_EMAIL="pubsub-invoker@your-gcp-project.iam.gserviceaccount.com"
# The audience configured on the Pub/Sub push subscription (typically your webhook URL)
PUBSUB_VERIFICATION_AUDIENCE="https://your-app.vercel.app/api/gmail-webhook"

# 5. Security & Encryption
# 32-byte hex string (64 characters) for AES-256-GCM encryption of refresh tokens
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# Secret required to initiate the one-time OAuth link (/api/oauth/start?secret=...)
OAUTH_SETUP_PASSWORD="your_secure_random_setup_password"
# Vercel Cron Secret (automatically provided by Vercel in production if enabled, or set manually)
CRON_SECRET="your_secure_cron_secret"

# 6. Localization
TZ="Asia/Dhaka"
